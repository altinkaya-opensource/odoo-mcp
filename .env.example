# Required
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin

# Set to true to block all write operations
READONLY_MODE=false

# Optional
ODOO_MCP_LOG_LEVEL=INFO
ODOO_MCP_LOG_FILE=
ODOO_MCP_DEFAULT_LIMIT=10
ODOO_MCP_MAX_LIMIT=100

# TOON output format for reduced token usage (~40-60% savings)
ODOO_MCP_TOON=true
